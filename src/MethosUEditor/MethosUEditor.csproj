<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Methos</AssemblyName>
    <ApplicationIcon>Assets\Methos.ico</ApplicationIcon>
    <RootNamespace>MethosUEditor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Eliot.UELib" Version="1.13.7" />
    <PackageReference Include="pythonnet" Version="3.0.5" />
    <ProjectReference Include="../MethosUEngine/MethosUEngine.csproj" />
  </ItemGroup>
</Project>
